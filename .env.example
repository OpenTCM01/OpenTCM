# Copy to .env locally. Never commit real credentials or deployment passwords.
DEEPSEEK_API_KEY=replace-with-your-own-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REVIEWER_MODEL=deepseek-v4-pro

# Generate a long random value for each installation.
FLASK_SECRET_KEY=replace-with-a-random-session-secret
OPENTCM_PASSWORD=replace-with-your-own-login-password

OPENTCM_KG_DB=data/opentcm_kg.sqlite
OPENTCM_MODERN_DB=data/opentcm_modern.sqlite
OPENTCM_CONVERSATION_DB=data/opentcm_conversations.sqlite
PORT=8000
